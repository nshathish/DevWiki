---
const { notes, activeCategory = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const folders = [...new Set(notes.map((note) => note.id.split('/')[0]))].filter((folder) => notes.some((note) => note.id.startsWith(`${folder}/`)));
const label = (folder) => folder.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const countFor = (folder) => notes.filter((note) => note.id.startsWith(`${folder}/`)).length;
---

<aside class="h-fit lg:sticky lg:top-8">
  <p class="eyebrow mb-4 text-accent">Browse by topic</p>
  <nav aria-label="Article categories" class="space-y-1 border-l border-ink/10 pl-4">
    <a href={`${base}articles`} class={`flex items-center justify-between py-2 text-sm ${activeCategory === '' ? 'font-semibold text-moss' : 'text-ink/55 hover:text-moss'}`}>
      <span>All notes</span><span class="font-mono text-[10px] text-ink/35">{notes.length}</span>
    </a>
    {folders.map((folder) => (
      <a href={`${base}articles/${folder}`} class={`flex items-center justify-between py-2 text-sm ${activeCategory === folder ? 'font-semibold text-moss' : 'text-ink/55 hover:text-moss'}`}>
        <span>{label(folder)}</span><span class="font-mono text-[10px] text-ink/35">{countFor(folder)}</span>
      </a>
    ))}
  </nav>
</aside>
